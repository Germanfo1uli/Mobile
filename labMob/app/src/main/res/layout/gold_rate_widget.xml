<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/gold_widget_sphere"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:layout_gravity="center"
    android:gravity="center"
    android:orientation="vertical"
    android:padding="20dp"
    android:background="@drawable/gold_widget_sphere">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="ЗОЛОТО"
        android:textColor="#09090D"
        android:textSize="13sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/gold_rate_value"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:gravity="center"
        android:maxLines="1"
        android:text="ОБНОВЛЯЕМ…"
        android:textColor="#FFFFFF"
        android:textSize="20sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/gold_rate_date"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:gravity="center"
        android:maxLines="2"
        android:text="ЦБ РФ"
        android:textColor="#17171D"
        android:textSize="9sp"
        android:textStyle="bold" />
</LinearLayout>
